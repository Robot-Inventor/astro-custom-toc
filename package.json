{
  "name": "astro-custom-toc",
  "version": "4.0.6",
  "description": "Astro Integration to generate a customizable table of contents",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier ./src/ --write",
    "format:check": "prettier ./src/ --check",
    "lint": "knip && oxlint ./src",
    "test": "vitest",
    "version": "npm run build && git add .",
    "changeset-version": "changeset version && npm run version",
    "changeset-publish": "npm run build && changeset publish"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/astro-custom-toc.git"
  },
  "keywords": [
    "astro",
    "withastro",
    "ui",
    "remark",
    "markdown",
    "astro-integration"
  ],
  "author": "Robot-Inventor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/astro-custom-toc/issues"
  },
  "homepage": "https://github.com/Robot-Inventor/astro-custom-toc#readme",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/markdown-satteri": "^0.4.0",
    "@types/hast": "^3.0.4",
    "github-slugger": "^2.0.0",
    "rehype-custom-toc": "^1.0.0",
    "remark-comment": "^1.0.0",
    "satteri": "^0.10.0",
    "unified": "^11.0.4"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/oxlint-config": "^0.2.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "astro": "^7.0.0",
    "knip": "^6.0.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.2.5",
    "typescript": "^7.0.0",
    "vfile": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
